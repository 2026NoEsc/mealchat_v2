EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# 개발 빌드에서 로컬 Supabase HTTP 연결을 명시적으로 허용할 때만 1. 운영 키와 혼용 금지.
EXPO_PUBLIC_SUPABASE_ALLOW_LOCAL_HTTP=0

# Tmap (SK open API) — 장소 검색 / 보행자 경로
# https://openapi.sk.com 가입 → 앱 생성 → TMAP 상품 등록 → 마이페이지 > 앱 에서 확인
EXPO_PUBLIC_TMAP_APP_KEY=replace_me
